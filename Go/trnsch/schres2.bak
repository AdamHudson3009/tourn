func dbl_gme_mp(one string, two string) {
	gme_mp[one] = two
	gme_mp_rev[two] = one
}

func gme_mp_prnt(key string) string {
	if is_gme_mp && (gme_mp[key] != "") {
		return gme_mp[key]
	} else {
		return key
	}
}

func gme_mp_prnt_rev(key string) string {
	if is_gme_mp && (gme_mp_rev[key] != "") {
		return gme_mp_rev[key]
	} else {
		return key
	}
}

func remove_from_act_str() {
	for a_i := range act_str {
		for a_i2 := len(act_str[a_i]) - 1; a_i2 >= 0; a_i2-- {
			if strings.Contains(";"+glb_elm+";", ";"+act_str[a_i][a_i2]+";") {
				act_str[a_i] = Splice(act_str[a_i], act_str[a_i][a_i2])
			}
		}
	}
}

func get_sch_extd(fname string, wh_wk int) {
	var spr_in_file *xlsx.File
	var sheet *xlsx.Sheet
	var cell *xlsx.Cell
	var err error
	spr_in_file, err = xlsx.OpenFile(fname)
	if err != nil {
		fmt.Println("Can not open input spr " + fname)
	}

	//var sprsd [] string
	for sht_i := range spr_in_file.Sheets {
		n := spr_in_file.Sheets[sht_i].Name

		if (n == "msc") || strings.HasPrefix(n, "Sheet") {
			continue
		}
		n = strings.ReplaceAll(n, "r", "")
		var n_i int
		n_i, err := strconv.Atoi(n)
		if (err != nil) || (n_i <= wh_wk) {
			continue
		}

		sheet = spr_in_file.Sheets[sht_i]
	L:
		for row := 1; ; row++ {
			for col := 0; col < 2; col++ {
				cell, _ = sheet.Cell(row, col)
				strings.TrimSpace(cell.Value)
				if strings.TrimSpace(cell.Value) == "" {
					if col == 0 {
						break L
					} else {
						break
					}
				}

				if col == 1 {
					tmp := cell.Value
					cell, _ = sheet.Cell(row, 0)
					other := cell.Value
					plyr_extd_sch[tmp] = other + ";" + plyr_extd_sch[tmp]
					plyr_extd_sch[other] = tmp + ";" + plyr_extd_sch[other]
				}
			}
		}
	}
}

func Re_sch_xls(fname string, wh_wk int) string {
	var spr_in_file *xlsx.File
	var sheet *xlsx.Sheet
	var cell *xlsx.Cell
	var err error
	spr_in_file, err = xlsx.OpenFile(fname)
	if err != nil {
		fmt.Println("Can not open input spr " + fname)
	}

	var sprsd []string
	result := ""
	get_return := false
	for sht_i := range spr_in_file.Sheets {
		n := spr_in_file.Sheets[sht_i].Name
		if (n == "msc") || strings.HasPrefix(n, "Sheet") {
			continue
		}
		if (wh_wk > 9) && strings.HasSuffix(n, strconv.Itoa(wh_wk)) {
			get_return = true
		} else if (wh_wk < 10) && strings.HasSuffix(n, strconv.Itoa(wh_wk)) && !strings.HasSuffix(n, strconv.Itoa(10+wh_wk)) {
			get_return = true
		} else {
			get_return = false
		}

		running_sht := n
		sheet = spr_in_file.Sheets[sht_i]
		tme_col := -1
	L:
		for row := 0; ; row++ {
			for col := 0; ; col++ {
				cell, _ = sheet.Cell(row, col)
				strings.TrimSpace(cell.Value)
				if strings.TrimSpace(cell.Value) == "" {
					if col == 0 {
						break L
					} else {
						break
					}
				}
				tmp := cell.Value
				if (row == 0) && (tmp == "GN") {
					tme_col = col
				} else if (row > 0) && (col == tme_col) {
					f, err2 := strconv.ParseFloat(tmp, 64)
					if err2 != nil {
						return ""
					}
					tmp = FloatToTme(f)
				}
				if _, hasKey := plyr_stnd_rplc[tmp]; hasKey {
					if get_return && (row > 0) && (col < 2) {
						result += ";" + plyr_stnd_rplc[tmp]
					}
					if col == 1 {
						cell, _ = sheet.Cell(row, 0)
						other := plyr_stnd_rplc[cell.Value]
						plyr_extd_sch[plyr_stnd_rplc[tmp]] = other + ";" + plyr_extd_sch[plyr_stnd_rplc[tmp]]
						plyr_extd_sch[other] = plyr_stnd_rplc[tmp] + ";" + plyr_extd_sch[other]
					}
					running_sht += AddRunningSht(row, col, plyr_stnd_rplc[tmp])
				} else {
					running_sht += AddRunningSht(row, col, tmp)
				}
			}
		}
		sprsd = append(sprsd, running_sht)
	}
	Sprsht_out2(strings.ReplaceAll(fname, ".xls", "-1.xls"), sprsd)
	return result
}

func attr_wk_assn(dir string, wk int, fnl_wk bool, schxls_fbase string, attr_w string, attr_blw string, is_wc bool, attr_orig bool) {
	Inter := false
	if strings.Contains(dir, "|Inter") {
		Inter = true
		dir = strings.ReplaceAll(dir, "|Inter", "")
	}
	linesA := LinesInFile(dir + "attr\\attr" + strconv.Itoa(wk) + ".txt")
	if linesA == nil {
		return
	}
	var spr_in_file *xlsx.File
	var sheet *xlsx.Sheet
	var cell *xlsx.Cell
	var err error

	spr_in_file, err = xlsx.OpenFile(schxls_fbase + ".xlsx")
	if err != nil {
		fmt.Println("Can not open input spr " + schxls_fbase + ".xlsx")
	}
	token_opts_w := ";potw;train;blout"
	token_opts_l := ";e;bloutls"
	token_hsh := make(map[string]string)
	token_chng := make(map[string]int)
	for sht_i := range spr_in_file.Sheets {
		n := spr_in_file.Sheets[sht_i].Name
		sheet = spr_in_file.Sheets[sht_i]
		if (n == "msc") && !is_wc {
			for row := 0; ; row++ {
				token := ""
				WTrue := false
				cell, _ = sheet.Cell(row, 0)
				v := cell.Value
				if v == "" {
					break
				}
				if v == strconv.Itoa(wk) {
					cell, _ = sheet.Cell(row, 1)
					v2 := cell.Value
					if strings.Contains(token_opts_w, ";"+v2+";") || (fnl_wk && (v2 == "d")) {
						token = v2
						WTrue = true
					} else if strings.Contains(token_opts_l, ";"+v2+";") {
						token = v2
						WTrue = false
					}
				} else if fnl_wk {
					cell, _ = sheet.Cell(row, 1)
					v2 := cell.Value
					if v2 == "d" {
						token = "d"
						WTrue = true
					}
				}
				if token != "" {
					for col := 2; ; col++ {
						cell, _ = sheet.Cell(row, col)
						v2 := cell.Value
						if v2 == "" {
							break
						}
						token_hsh[token] += "," + v2
						if WTrue {
							token_chng[v2]++
						} else {
							token_chng[v2]--
						}
					}
				}
			}
		} else if (n == "wc") && is_wc {
			pt_c := -1
			pa_c := -1
			tc_c := -1
			for col := 3; ; col++ {
				cell, _ = sheet.Cell(0, col)
				v := cell.Value
				if v == "Pt" {
					pt_c = col
				} else if v == "Pa" {
					pa_c = col
				} else if v == "T" {
					tc_c = col
				} else if v == "" {
					break
				}
			}
			spaces := 0
			for row := 1; ; row++ {
				cell, _ = sheet.Cell(row, 0)
				v := cell.Value
				if v == "" {
					spaces++
					if spaces >= 5 {
						break
					}
				} else {
					spaces = 0
				}
				cell, _ = sheet.Cell(row, pa_c)
				v = cell.Value
				if v == "0" {
					cell, _ = sheet.Cell(row, 2)
					v = cell.Value
					token_hsh["sht wn"] += "," + v
					token_chng[v]++
				} else {
					cell, _ = sheet.Cell(row, tc_c)
					v = cell.Value
					if v == "T" {
						cell, _ = sheet.Cell(row, pt_c)
						v = cell.Value
						if StrToInt(v) >= 8 {
							cell, _ = sheet.Cell(row, 2)
							v = cell.Value
							token_hsh["blout wn"] += "," + v
							token_chng[v]++
						}
					}
				}
			}
			break
		} else if !is_wc {
			n = ReplaceIfThere(n, gme_mp["r"], "r")
			if n != "r"+strconv.Itoa(wk) {
				continue
			}
			pt_c := -1
			pa_c := -1
			rec_c := -1
			for col := 3; ; col++ {
				cell, _ = sheet.Cell(0, col)
				v := cell.Value
				if v == "Pt" {
					pt_c = col
				} else if v == "Pa" {
					pa_c = col
				} else if v == "Rec" {
					rec_c = col
				} else if v == "" {
					break
				}
			}
			attr_w = strings.ReplaceAll(attr_w, ";", ",") + ","
			///blout
			blw_pt_strt := 0
			attr_blws := strings.Split(attr_blw, ";")
			blt_ls := false
			var blw_pt_arr []string
			if len(attr_blws) > 2 {
				blt_ls = attr_blws[1] == "l"
				blw_pt_strt = StrToInt(attr_blws[2])
				blw_pt_arr = strings.Split(attr_blws[3], ",")
			}

			for row := 1; ; row++ {
				cell, _ = sheet.Cell(row, 2)
				vw := cell.Value
				if vw == "" {
					break
				}
				cell, _ = sheet.Cell(row, 0)
				v1 := cell.Value
				rec_i := 0
				if v1 != vw {
					rec_i = 1
				}
				rec_i2 := (rec_i + 1) % 2
				cell, _ = sheet.Cell(row, pt_c)
				vpt := strings.TrimSpace(cell.Value)
				vpt_i := StrToInt(vpt)
				//shout
				cell, _ = sheet.Cell(row, pa_c)
				vpz := strings.TrimSpace(cell.Value) == "0"
				if vpz && (vpt_i > 0) {
					token_hsh["sht wn"] += "," + vw
					token_chng[vw]++
					cell, _ = sheet.Cell(row, rec_i2)
					vl := strings.TrimSpace(cell.Value)
					token_hsh["sht ls"] += "," + vl
					token_chng[vl]--
				}
				cell, _ := sheet.Cell(row, rec_c)
				rec_str := strings.TrimSpace(cell.Value)
				recs := strings.Split(rec_str, "--")
				for recs_ii := 0; recs_ii < 2; recs_ii++ {
					recs[recs_ii] = strings.ReplaceAll(recs[recs_ii], "e", "")
					recs[recs_ii] = strings.ReplaceAll(recs[recs_ii], "d", "")
					recs[recs_ii] = strings.ReplaceAll(recs[recs_ii], "D", "")
					recs[recs_ii] = strings.ReplaceAll(recs[recs_ii], "p", "")
				}
				if Inter {
					fmt.Println("ddd", row)
				}
				rec_int_value_1 := StrToInt(recs[rec_i])
				//blout
				if (len(blw_pt_arr) > 0) && (wk >= StrToInt(blw_pt_arr[0])) && (blw_pt_strt > 0) && (vpt_i >= blw_pt_strt) {
					rec_int_value_2 := StrToInt(recs[rec_i2])
					rec_int_value_3 := rec_int_value_1
					for blw_pt_arr_i := 1; blw_pt_arr_i < len(blw_pt_arr); blw_pt_arr_i++ {
						if wk >= StrToInt(blw_pt_arr[blw_pt_arr_i]) {
							rec_int_value_3--
						} else {
							break
						}
					}
					if rec_int_value_3 <= rec_int_value_2 {
						token_hsh["blt wn"] += "," + vw
						token_chng[vw]++
						if blt_ls {
							cell, _ = sheet.Cell(row, rec_i2)
							vl := strings.TrimSpace(cell.Value)
							token_hsh["blt ls"] += "," + vl
							token_chng[vl]--
						}
					}
				}

				rec_int_value_1++
				rec_value := strconv.Itoa(rec_int_value_1)
				if strings.Contains(attr_w, ","+rec_value+",") {
					token_hsh["wn "+rec_value] += "," + vw
					token_chng[vw]++
				}
				if fnl_wk && (rec_int_value_1 == wk) && (wk > 5) {
					token_hsh["undef"] += "," + vw
					token_chng[vw] += 2
				}
			}
		}
	}
	for p, _ := range plrs {
		if nme_attr_int[p+";arw"] > 0 {
			token_hsh["arch"] += "," + p
			token_chng[p]++
		}
	}
	//attr chnge
	fmt.Println(token_hsh)

	subthefile := "wc"
	if !is_wc {

		if (LetterArrMax > 1) && (LetterArrIndx > 1) {
			if Inter {
				subthefile = strconv.Itoa(wk) + LetterArr[LetterArrIndx]
			} else {
				subthefile = strconv.Itoa(wk) + LetterArr[LetterArrIndx-1]
			}
		} else {
			subthefile = strconv.Itoa(wk)
		}
	}
	lines := LinesInFile(dir + "\\attr\\attr" + subthefile + ".txt")

	buffer := ""
	attr_order := make(map[int]int)
	//upper
	attr_order[1] = 1
	attr_order[2] = 2
	attr_order[3] = 3
	attr_order[4] = 1
	attr_order[5] = 4
	//lower
	attr_order[0] = 4
	attr_order[-1] = 3
	attr_order[-2] = 2
	attr_order[-3] = 4
	attr_order[-4] = 1

	has_spcl := 0
	for lines_i := 0; lines_i < len(lines); lines_i++ {
		l := strings.TrimSpace(lines[lines_i])
		if l == "" {
			continue
		}
		if l == "has_spcl" {
			has_spcl = 1
			//upper
			attr_order[1] = 1
			attr_order[2] = 2
			attr_order[3] = 3
			attr_order[4] = 4
			attr_order[5] = 1
			attr_order[6] = 5
			//lower
			attr_order[0] = 5
			attr_order[-1] = 4
			attr_order[-2] = 3
			attr_order[-3] = 2
			attr_order[-4] = 5
			attr_order[-5] = 1
			buffer += l + "\r\n"
			continue
		}
		if strings.Contains(l, "[attr chng]") {
			break
		} else if regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,-\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+,\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+,-\d$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,-\d+,-\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+,\d+,\d+$`).MatchString(l) {
			onetwo := strings.Split(l, "=")
			if token_chng[onetwo[0]] == 0 {
				buffer += l + "\r\n"
			} else {
				attr_nmbrs := strings.Split(onetwo[1], ",")
				if attr_orig {
					if len(attr_nmbrs) < (5 + has_spcl) {
						onetwo[1] += ",0"
						attr_nmbrs = strings.Split(onetwo[1], ",")
					}
					if len(attr_nmbrs) < (6 + has_spcl) {
						onetwo[1] += "," + attr_nmbrs[4+has_spcl]
						attr_nmbrs = strings.Split(onetwo[1], ",")
					}
				}
				var ostspd []int
				ostspd = append(ostspd, StrToInt(attr_nmbrs[0])*10+2)
				ostspd = append(ostspd, StrToInt(attr_nmbrs[1])*10)
				ostspd = append(ostspd, StrToInt(attr_nmbrs[2])*10+1)
				ostspd = append(ostspd, StrToInt(attr_nmbrs[3])*10+3)
				if has_spcl == 1 {
					ostspd = append(ostspd, StrToInt(attr_nmbrs[4])*10+4)
				}
				cur_num := 0
				if len(attr_nmbrs) > (4 + has_spcl) {
					cur_num = StrToInt(attr_nmbrs[4+has_spcl])
				}
				min_num := -9999
				if len(attr_nmbrs) > (5 + has_spcl) {
					min_num = StrToInt(attr_nmbrs[5+has_spcl])
				}
				sort.Ints(ostspd)
				if token_chng[onetwo[0]] > 0 {
					for indx := cur_num + 1; indx <= (cur_num + token_chng[onetwo[0]]); indx++ {
						indx2 := indx
						for indx2 > (5 + has_spcl) {
							indx2 -= (4 + has_spcl)
						}
						for indx2 < (-4 - has_spcl) {
							indx2 += (4 + has_spcl)
						}
						ostspd[4+has_spcl-attr_order[indx2]] += 10
					}
				} else {
					for indx := cur_num; (indx > (cur_num + token_chng[onetwo[0]])) && (indx > min_num); indx-- {
						indx2 := indx
						for indx2 > (5 + has_spcl) {
							indx2 -= (4 + has_spcl)
						}
						for indx2 < (-4 - has_spcl) {
							indx2 += (4 + has_spcl)
						}
						ostspd[4+has_spcl-attr_order[indx2]] -= 10
					}
				}
				for indx := 0; indx < 4+has_spcl; indx++ {
					if (ostspd[indx] % 10) == 2 {
						attr_nmbrs[0] = strconv.Itoa((ostspd[indx] - 2) / 10)
					} else if (ostspd[indx] % 10) == 0 {
						attr_nmbrs[1] = strconv.Itoa(ostspd[indx] / 10)
					} else if (ostspd[indx] % 10) == 1 {
						attr_nmbrs[2] = strconv.Itoa((ostspd[indx] - 1) / 10)
					} else if (ostspd[indx] % 10) == 3 {
						attr_nmbrs[3] = strconv.Itoa((ostspd[indx] - 3) / 10)
					} else {
						attr_nmbrs[4] = strconv.Itoa((ostspd[indx]-4)/10) + ","
					}
				}
				if attr_orig {
					tmp_tmp := cur_num + token_chng[onetwo[0]]
					if tmp_tmp < min_num {
						tmp_tmp = min_num
					}

					buffer += onetwo[0] + "=" + attr_nmbrs[0] + "," + attr_nmbrs[1] + "," + attr_nmbrs[2] + "," + attr_nmbrs[3] + "," + attr_nmbrs[4] + strconv.Itoa(tmp_tmp) + "," + strconv.Itoa(min_num) + "\r\n"
				} else {
					buffer += onetwo[0] + "=" + attr_nmbrs[0] + "," + attr_nmbrs[1] + "," + attr_nmbrs[2] + "," + attr_nmbrs[3] + "," + attr_nmbrs[4] + strconv.Itoa(cur_num+token_chng[onetwo[0]]) + "\r\n"
				}
			}
		} else {
			buffer += l + "\r\n"
		}
	}
	first := true
	for key, value := range token_hsh {
		if first {
			buffer += "[attr chng]\r\n"
			first = false
		}
		buffer += key + "=" + value[1:] + "\r\n"
	}
	first = true
	for key, value := range token_chng {
		if first {
			buffer += "[nme chng]\r\n"
			first = false
		}
		buffer += key + "=" + strconv.Itoa(value) + "\r\n"
	}
	fle2 := ""
	if (LetterArrMax > 1) && (!Inter) {
		fle2 = dir + "\\attr\\attr" + strconv.Itoa(wk) + LetterArr[LetterArrIndx] + ".txt"
	} else {
		fle2 = dir + "\\attr\\attr" + strconv.Itoa(wk+1) + ".txt"
		if is_wc {
			fle2 = dir + "\\attr\\attrwc-2.txt"
		} else if fnl_wk {
			fle2 = dir + "\\attr\\attrwc.txt"
		}
	}
	if err := os.WriteFile(fle2, []byte(buffer), 0644); err != nil {
		fmt.Println(err)
	}
	if (LetterArrMax > 1) && (LetterArrIndx == LetterArrMax) && (!Inter) {
		attr_wk_assn(dir+"|Inter", wk, fnl_wk, strings.ReplaceAll(schxls_fbase, "trn"+LetterArr[LetterArrIndx], "inter"), attr_w, attr_blw, is_wc, attr_orig)
	}
}

func ReplaceIfThere(str string, s1 string, s2 string) string {
	if s1 == "" {
		return str
	} else {
		return strings.ReplaceAll(str, s1, s2)
	}
}

func LinesInFile(fname string) []string {
	gen_bfile, err := os.ReadFile(fname)
	gen_is := err == nil
	if !gen_is {
		fmt.Println("file not found: " + fname)
		return nil
	}
	gen_file := fmt.Sprintf("%s", gen_bfile)
	lines := strings.Split(gen_file, "\r\n")
	return lines
}

func attr_wk_assn2(dir string, wk int, schxls_fbase string) {
	var spr_in_file *xlsx.File
	var sheet *xlsx.Sheet
	var cell *xlsx.Cell
	var err error

	spr_in_file, err = xlsx.OpenFile(schxls_fbase)
	if err != nil {
		fmt.Println("Can not open input spr " + schxls_fbase)
	}

	token_opts_w := ";shout;blout;r2w5;r3w6;r1w4;srvall;potbr;"
	token_hsh := make(map[string]string)
	token_chng := make(map[string]int)
	for sht_i := range spr_in_file.Sheets {
		n := spr_in_file.Sheets[sht_i].Name
		sheet = spr_in_file.Sheets[sht_i]
		if n == "msc" {
			for row := 0; ; row++ {
				token := ""
				WTrue := false
				cell, _ = sheet.Cell(row, 0)
				v := cell.Value
				if v == "" {
					break
				}
				if v == strconv.Itoa(wk) {
					cell, _ = sheet.Cell(row, 1)
					v2 := cell.Value
					if strings.Contains(token_opts_w, ";"+v2+";") {
						token = v2
						WTrue = true
					}
				}
				if token != "" {
					for col := 2; ; col++ {
						cell, _ = sheet.Cell(row, col)
						v2 := cell.Value
						if v2 == "" {
							break
						}
						token_hsh[token] += "," + v2
						if WTrue {
							token_chng[v2]++
						} else {
							token_chng[v2]--
						}
					}
				}
			}
		}
	}
	fmt.Println("TC", token_chng)

	//attr chnge
	fmt.Println("TH", token_hsh)

	subthefile := strconv.Itoa(wk)
	lines := LinesInFile(dir + "attr\\attr" + subthefile + ".txt")

	buffer := ""
	attr_order := make(map[int]int)
	//upper
	attr_order[1] = 1
	attr_order[2] = 2
	attr_order[3] = 3
	attr_order[4] = 1
	attr_order[5] = 4
	//lower
	attr_order[0] = 4
	attr_order[-1] = 3
	attr_order[-2] = 2
	attr_order[-3] = 4
	attr_order[-4] = 1

	has_spcl := 0
	for lines_i := 0; lines_i < len(lines); lines_i++ {
		l := strings.TrimSpace(lines[lines_i])
		if l == "" {
			continue
		}
		if l == "has_spcl" {
			has_spcl = 1
			//upper
			attr_order[1] = 1
			attr_order[2] = 2
			attr_order[3] = 3
			attr_order[4] = 4
			attr_order[5] = 1
			attr_order[6] = 5
			//lower
			attr_order[0] = 5
			attr_order[-1] = 4
			attr_order[-2] = 3
			attr_order[-3] = 2
			attr_order[-4] = 5
			attr_order[-5] = 1
			buffer += l + "\r\n"
			continue
		}
		if strings.Contains(l, "[attr chng]") {
			break
		} else if regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,-\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+,\d+$`).MatchString(l) || regexp.MustCompile(`^\w+=\d+,\d+,\d+,\d+,\d+-\d+$`).MatchString(l) {
			onetwo := strings.Split(l, "=")
			if token_chng[onetwo[0]] == 0 {
				buffer += l + "\r\n"
			} else {
				attr_nmbrs := strings.Split(onetwo[1], ",")
				var ostspd []int
				ostspd = append(ostspd, StrToInt(attr_nmbrs[0])*10+2)
				ostspd = append(ostspd, StrToInt(attr_nmbrs[1])*10)
				ostspd = append(ostspd, StrToInt(attr_nmbrs[2])*10+1)
				ostspd = append(ostspd, StrToInt(attr_nmbrs[3])*10+3)
				if has_spcl == 1 {
					ostspd = append(ostspd, StrToInt(attr_nmbrs[4])*10+4)
				}
				cur_num := 0
				if len(attr_nmbrs) > (4 + has_spcl) {
					cur_num = StrToInt(attr_nmbrs[4+has_spcl])
				}
				/*min_num := -9999
				  if len(attr_nmbrs) > (5+has_spcl) {
				  min_num = StrToInt(attr_nmbrs[5+has_spcl])
				  }*/
				sort.Ints(ostspd)
				if token_chng[onetwo[0]] > 0 {
					for indx := cur_num + 1; indx <= (cur_num + token_chng[onetwo[0]]); indx++ {
						indx2 := indx
						for indx2 > (5 + has_spcl) {
							indx2 -= (4 + has_spcl)
						}
						for indx2 < (-4 - has_spcl) {
							indx2 += (4 + has_spcl)
						}
						ostspd[4+has_spcl-attr_order[indx2]] += 10
					}
				} else {
					for indx := cur_num; indx > (cur_num + token_chng[onetwo[0]]); indx-- {
						indx2 := indx
						for indx2 > (5 + has_spcl) {
							indx2 -= (4 + has_spcl)
						}
						for indx2 < (-4 - has_spcl) {
							indx2 += (4 + has_spcl)
						}
						ostspd[4+has_spcl-attr_order[indx2]] -= 10
					}
				}
				for indx := 0; indx < 4+has_spcl; indx++ {
					if (ostspd[indx] % 10) == 2 {
						attr_nmbrs[0] = strconv.Itoa((ostspd[indx] - 2) / 10)
					} else if (ostspd[indx] % 10) == 0 {
						attr_nmbrs[1] = strconv.Itoa(ostspd[indx] / 10)
					} else if (ostspd[indx] % 10) == 1 {
						attr_nmbrs[2] = strconv.Itoa((ostspd[indx] - 1) / 10)
					} else if (ostspd[indx] % 10) == 3 {
						attr_nmbrs[3] = strconv.Itoa((ostspd[indx] - 3) / 10)
					} else {
						attr_nmbrs[4] = strconv.Itoa((ostspd[indx]-4)/10) + ","
					}
				}
				buffer += onetwo[0] + "=" + attr_nmbrs[0] + "," + attr_nmbrs[1] + "," + attr_nmbrs[2] + "," + attr_nmbrs[3] + "," + attr_nmbrs[4] + strconv.Itoa(cur_num+token_chng[onetwo[0]]) + "\r\n"
			}
		} else {
			buffer += l + "\r\n"
		}
	}
	first := true
	for key, value := range token_hsh {
		if first {
			buffer += "[attr chng]\r\n"
			first = false
		}
		buffer += key + "=" + value[1:] + "\r\n"
	}
	first = true
	for key, value := range token_chng {
		if first {
			buffer += "[nme chng]\r\n"
			first = false
		}
		buffer += key + "=" + strconv.Itoa(value) + "\r\n"
	}
	fle2 := dir + "attr\\attr" + strconv.Itoa(wk+1) + ".txt"

	if err := os.WriteFile(fle2, []byte(buffer), 0644); err != nil {
		fmt.Println(err)
	}
}

func AddRunningShtPSCols(rw, cl int, str string, ps_wrt bool) string {
	if ps_wrt {
		if ps_buffer_cols == "" {
			ps_buffer_cols = "/cols [(" + str + ")"
		} else {
			ps_buffer_cols += " (" + str + ")"
		}
	}
	return AddRunningSht(rw, cl, str)
}

func AddRunningShtPS(rw, cl int, str string) string {
	ps_buffer[len(ps_buffer)-1] += " (" + str + ")"
	return AddRunningSht(rw, cl, str)
}

func PSBracket(open bool, str string) {
	if open {
		ps_buffer[len(ps_buffer)-1] += "["
		if str != "" {
			ps_buffer[len(ps_buffer)-1] += "(" + str + ")"
		}
	} else {
		ps_buffer[len(ps_buffer)-1] += "]"
	}
}

func ps_done(dir string) {
	if ps_buffer_cols != "" {
		ps_buffer_cols += "] def"
	}
	buffer_man := ps_buffer_cols + "\r\n"
	buffer_man += "/stdn [\r\n"
	for aaa := 0; aaa < len(ps_buffer); aaa++ {
		buffer_man += ps_buffer[aaa] + "]\r\n"
	}
	buffer_man += "] def \r\n/cn_hgt 40 def\r\n/dv_hgt 30 def\r\n/plr_hgt 24 def\r\n/mrgns 5 def\r\nmk_stdn\r\n"
	err := os.WriteFile(dir+"schRes.ps", []byte(buffer_man), 0644)
	if err != nil {
		fmt.Println(err)
	}
}
